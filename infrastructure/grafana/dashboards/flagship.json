        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (policy) (rate(flagship_ratelimit_rejected_total[5m]))",
          "legendFormat": "{{policy}}",
          "datasource": {
            "type": "prometheus",
            "uid": "flagship-prometheus"
          }
        }
      ]
    },
    {
